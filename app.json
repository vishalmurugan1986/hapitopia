{
  "expo": {
    "name": "Habitopia",
    "slug": "habitopia",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios"
    ],
    "icon": "./assets/habitopia_sprout_app_icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.achariya.habitopia"
    },
    "android": {
      "package": "com.achariya.habitopia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/habitopia_sprout_app_icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Habitopia lets you choose a photo to show you completed a habit.",
          "cameraPermission": "Habitopia uses the camera so you can take a photo of a habit you completed.",
          "microphonePermission": "Habitopia uses the microphone only when you record a video of a habit you completed."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/habitopia_sprout_logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4ee1ed53-f550-408c-9932-60862ad7a05c"
      }
    },
    "owner": "vishalfsds-team"
  }
}
